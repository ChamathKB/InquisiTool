# Copy this file to .env and fill in your values

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Database Configuration (Docker defaults)
MONGO_URL=mongodb://mongodb:27017
MONGO_DB_NAME=agentic_rag_db
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333

# Collection Names
COLLECTION_KNOWLEDGEBASE=knowledge_bases
COLLECTION_DOCUMENT_UPLOADS=document_collections

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=inquisitool
KEYCLOAK_CLIENT_ID=inquisitool-api
KEYCLOAK_CLIENT_SECRET=your_client_secret_here

# Keycloak Admin & DB (used by docker-compose)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here
KC_DB_NAME=keycloak
KC_DB_USERNAME=your_keycloak_db_user_here
KC_DB_PASSWORD=your_keycloak_db_password_here
